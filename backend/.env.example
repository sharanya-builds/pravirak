PORT=4000
NODE_ENV=production
FRONTEND_URL=https://pravirak.onrender.com
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL connection. Either set DATABASE_URL (used as-is, e.g. for a
# managed provider like Render/Railway/Supabase/RDS/Neon)...
DATABASE_URL=postgres://pravirak:pravirak@localhost:5432/pravirak
# ...or leave DATABASE_URL unset and use these discrete vars instead
# (DATABASE_URL takes priority if both are present):
PGHOST=localhost
PGPORT=5432
PGUSER=pravirak
PGPASSWORD=pravirak
PGDATABASE=pravirak
# Set to "require" if your Postgres provider needs SSL (most managed ones do).
PGSSL=

# Optional: enables AI-grounded government scheme lookup (via OpenRouter's
# web-search plugin). Without this, the app falls back to the static
# scheme dataset. Get a key at https://openrouter.ai/keys — add credits to
# your OpenRouter account (even the free-tier requires this) or every model
# call will fail with 402.
OPENROUTER_API_KEY=
# Optional. Forces one specific OpenRouter model slug (e.g.
# "google/gemini-2.5-flash", "openai/gpt-4o-mini") regardless of the
# built-in candidate list. Leave blank to let the service pick from a
# short, verified list of cheap/reliable models automatically.
OPENROUTER_MODEL=
# Optional. Sent as the HTTP-Referer header on OpenRouter requests (used by
# OpenRouter for per-app analytics/rate-limit fairness, not required to work).
OPENROUTER_SITE_URL=https://pravirak.app
